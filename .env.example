# Stack core (SeaweedFS + Postgres) y spike. Copiar a .env y reemplazar las credenciales (no commitear .env).
# docker-compose.spike.yml usa las mismas S3_*.
# Prefijo S3_ (no AWS_) para no pisar credenciales AWS reales del entorno del desarrollador;
# el compose las mapea a AWS_* dentro del contenedor.
# 127.0.0.1: el puerto S3 solo se publica en loopback.
# S3_ENDPOINT_URL y S3_REGION: cliente S3 de pits (pits storage) y tests/contract; S3_CONTRACT_LARGE_MB: solo tests/contract.
S3_ENDPOINT_URL=http://127.0.0.1:8333
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me-at-least-16-chars
S3_REGION=us-east-1
# Tamaño (MB) del objeto grande en los tests de contrato (multipart).
S3_CONTRACT_LARGE_MB=128
# Bucket raw de la plataforma (D61). No usar el prefijo pits-contract- (reservado a tests).
S3_RAW_BUCKET=pits-raw
# Bucket normalized (D74): salida derivable del raw (fx_rate CSV + manifest). Distinto del raw;
# sin prefijo pits-contract-. Opcional: si falta, se usa pits-normalized.
S3_NORMALIZED_BUCKET=pits-normalized

# Perfil de compose que levanta seaweedfs + postgres.
COMPOSE_PROFILES=core
# Postgres local (D60). El puerto solo se publica en 127.0.0.1.
POSTGRES_USER=pits
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pits
# 5433 porque 5432 suele estar ocupado por un Postgres nativo de Windows.
POSTGRES_HOST_PORT=5433

# SODA (datos.gov.co) para `pits extract`. El token es OPCIONAL (reduce el throttling); sin token funciona igual.
# Nunca commitear un token real.
SODA_APP_TOKEN=
# SODA_BASE_URL=https://www.datos.gov.co

# Warehouse Postgres (D79). Host solo loopback; puerto = POSTGRES_HOST_PORT (default 5433, nunca 5432).
# Base destino (default pits_warehouse). POSTGRES_USER/POSTGRES_PASSWORD solo los usa `pits db migrate` (admin; la contrasena solo debe no estar vacia).
PITS_PG_HOST=127.0.0.1
PITS_WAREHOUSE_DB=pits_warehouse
# Contrasenas (>=16 caracteres) de los roles pits_loader y pits_reader; el bootstrap las configura.
PITS_PG_LOADER_PASSWORD=
PITS_PG_READER_PASSWORD=
# Contrasena (>=16 caracteres) del rol pits_transformer (dbt, D86); `pits db migrate` la exige.
PITS_PG_TRANSFORMER_PASSWORD=

# Airflow (D89, D93). Perfil `orchestration`: se suma al core (ver abajo).
# Solo las exige docker-compose.orchestration.yml (D95); el compose del core no las necesita.
# Uso: COMPOSE_FILE=docker-compose.yml;docker-compose.orchestration.yml (";" en Windows, ":" en Linux)
# y COMPOSE_PROFILES=core,orchestration. Valores sin comillas ni espacios; nunca commitear los reales.
# Base y rol `airflow_meta` de la metadata DB: los crea el admin con `uv run pits db init-airflow-meta`
# (necesita POSTGRES_USER/POSTGRES_PASSWORD y esta contrasena). >=16 caracteres.
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
AIRFLOW_METADB_PASSWORD=
# Clave Fernet (cifra conexiones/variables en la metadata DB).
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# (equivale a Fernet.generate_key(); no exige instalar cryptography en el host)
AIRFLOW_FERNET_KEY=
# Secreto JWT compartido por apiserver, scheduler y dag-processor (firma de los tokens de la Execution API).
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AIRFLOW_API_JWT_SECRET=
# Clave de sesion/firma de la API de Airflow (AIRFLOW__API__SECRET_KEY): fija y compartida entre procesos.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AIRFLOW_API_SECRET_KEY=
# Contrasena del usuario `admin` de la UI (SimpleAuthManager, solo desarrollo; la UI solo escucha en loopback).
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
AIRFLOW_ADMIN_PASSWORD=
# Puerto local de la UI de Airflow (solo 127.0.0.1). Opcional.
# AIRFLOW_HOST_PORT=8080
