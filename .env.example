# Stack core (SeaweedFS + Postgres) y spike. Copiar a .env y reemplazar las credenciales (no commitear .env).
# docker-compose.spike.yml usa las mismas S3_*.
# Prefijo S3_ (no AWS_) para no pisar credenciales AWS reales del entorno del desarrollador;
# el compose las mapea a AWS_* dentro del contenedor.
# 127.0.0.1: el puerto S3 solo se publica en loopback.
# S3_ENDPOINT_URL y S3_REGION: cliente S3 de pits (pits storage) y tests/contract; S3_CONTRACT_LARGE_MB: solo tests/contract.
S3_ENDPOINT_URL=http://127.0.0.1:8333
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me-at-least-16-chars
S3_REGION=us-east-1
# Tamaño (MB) del objeto grande en los tests de contrato (multipart).
S3_CONTRACT_LARGE_MB=128
# Bucket raw de la plataforma (D61). No usar el prefijo pits-contract- (reservado a tests).
S3_RAW_BUCKET=pits-raw

# Perfil de compose que levanta seaweedfs + postgres.
COMPOSE_PROFILES=core
# Postgres local (D60). El puerto solo se publica en 127.0.0.1.
POSTGRES_USER=pits
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pits
# 5433 porque 5432 suele estar ocupado por un Postgres nativo de Windows.
POSTGRES_HOST_PORT=5433

# SODA (datos.gov.co) para `pits extract`. El token es OPCIONAL (reduce el throttling); sin token funciona igual.
# Nunca commitear un token real.
SODA_APP_TOKEN=
# SODA_BASE_URL=https://www.datos.gov.co
